{
  "$defs": {
    "Column": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ColumnType"
        },
        "data_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Warehouse type as reported by dbt, if known.",
          "title": "Data Type"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "Column",
      "type": "object"
    },
    "ColumnType": {
      "description": "Logical type, used to validate filter values and pick legal aggregations.",
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "date",
        "timestamp",
        "other"
      ],
      "title": "ColumnType",
      "type": "string"
    },
    "Dimension": {
      "additionalProperties": false,
      "description": "A semantic-layer dimension a metric can be grouped and filtered by.",
      "properties": {
        "name": {
          "description": "Qualified name, e.g. 'customer__region' or 'metric_time'.",
          "pattern": "^[A-Za-z0-9_]+$",
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "categorical",
            "time"
          ],
          "title": "Kind",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Logical type if known; otherwise inferred from filter values."
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "grains": {
          "description": "Time dimensions: allowed grains, finest first.",
          "items": {
            "type": "string"
          },
          "title": "Grains",
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "Dimension",
      "type": "object"
    },
    "MetricTool": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "metric",
          "default": "metric",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "unique_id": {
          "description": "dbt unique_id of the source metric.",
          "title": "Unique Id",
          "type": "string"
        },
        "metric": {
          "description": "Metric name in the semantic manifest.",
          "pattern": "^[A-Za-z0-9_]+$",
          "title": "Metric",
          "type": "string"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "requires_metric_time": {
          "default": false,
          "description": "True when every query must group by metric_time: cumulative metrics with a window or grain_to_date, and metrics built on a time offset (e.g. month-on-month).",
          "title": "Requires Metric Time",
          "type": "boolean"
        },
        "default_limit": {
          "exclusiveMinimum": 0,
          "title": "Default Limit",
          "type": "integer"
        },
        "max_limit": {
          "exclusiveMinimum": 0,
          "title": "Max Limit",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "description",
        "unique_id",
        "metric",
        "dimensions",
        "default_limit",
        "max_limit"
      ],
      "title": "MetricTool",
      "type": "object"
    },
    "ModelTool": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "model",
          "default": "model",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "unique_id": {
          "description": "dbt unique_id of the source model.",
          "title": "Unique Id",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/Relation"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "default_limit": {
          "exclusiveMinimum": 0,
          "title": "Default Limit",
          "type": "integer"
        },
        "max_limit": {
          "exclusiveMinimum": 0,
          "title": "Max Limit",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "description",
        "unique_id",
        "relation",
        "columns",
        "default_limit",
        "max_limit"
      ],
      "title": "ModelTool",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "database": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Database"
        },
        "schema": {
          "title": "Schema",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "identifier"
      ],
      "title": "Relation",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "project_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Name"
        },
        "dbt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dbt Version"
        },
        "adapter_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Type"
        }
      },
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "tools": {
      "items": {
        "discriminator": {
          "mapping": {
            "metric": "#/$defs/MetricTool",
            "model": "#/$defs/ModelTool"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ModelTool"
          },
          {
            "$ref": "#/$defs/MetricTool"
          }
        ]
      },
      "title": "Tools",
      "type": "array"
    },
    "semantic_manifest": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "dbt's semantic_manifest.json, embedded when metric tools are present.",
      "title": "Semantic Manifest"
    }
  },
  "required": [
    "generated_at",
    "source",
    "tools"
  ],
  "title": "Artifact",
  "type": "object"
}
